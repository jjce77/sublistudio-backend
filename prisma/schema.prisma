// Prisma + Turso (libSQL) — ver adr-sublistudio.md DEC-01, DEC-02, DEC-05, DEC-06
//
// ─────────────────────────────────────────────────────────────
// CONVENCIÓN DE NOMBRES (DEC-06 — aplica ../documentacion-sublistudio/technical-docs/Estandar_desarrrollo_bases_datos.md)
// ─────────────────────────────────────────────────────────────
// El estándar interno permite español o inglés para negocio ("Coherencia con el dominio") —
// este proyecto usa **inglés en ambas capas**, decisión explícita del equipo.
//   - Lado Prisma/TypeScript (izquierda de cada campo): camelCase (`user.passwordHash`).
//   - Lado base de datos real (dentro de @map/@@map): snake_case (`password_hash`).
// La convención `snake_case` del estándar es independiente del idioma — sigue exigiendo el
// mapeo camelCase → snake_case aunque ambas capas compartan idioma, por eso @map/@@map se
// mantienen en todo el schema.
//
// Timestamps: se unifica TODA fecha/hora (de negocio o de auditoría) con sufijo `_at`
// (`last_login_at`, `otp_expires_at`, `started_at`, `created_at`...). El estándar distinguía
// prefijo `fecha_` (negocio, pensado para español) vs. sufijo `_at` (auditoría, inglés) porque
// asumía idiomas distintos por tipo de campo; al ir todo en inglés, esa distinción se vuelve
// redundante — se adopta el patrón `_at` de forma uniforme, coherente con la convención inglesa
// estándar (Rails/TypeORM/Prisma) y con la propia regla de auditoría del estándar.
//
// Desviaciones documentadas respecto al estándar (con justificación):
// 1. Moneda: el estándar recomienda evitar punto flotante y usar DECIMAL/NUMERIC (ya no es
//    prohibición absoluta, pero sigue siendo la recomendación). SQLite/Turso no tiene un tipo
//    decimal de precisión fija (solo NULL/INTEGER/REAL/TEXT/BLOB). Se mantiene el patrón estándar
//    de la industria (ej. Stripe): guardar el monto como entero en la unidad mínima de la moneda
//    (centavos) — evita errores de redondeo de punto flotante sin depender de un tipo inexistente
//    en el motor, incluso ahora que la regla es una recomendación y no una prohibición.
// 2. "Campo descriptivo tras la PK nombrado como la tabla (singular)": aplicado literalmente en
//    catálogos simples (roles→role, categories→category, plans→plan). NO aplicado en entidades
//    complejas (users, resources) donde forzarlo produce nombres sin sentido (`user.user`).
//    Se usa en su lugar el campo más identificador (email, title).
// 3. AuditLog (audit_logs) no tiene `updated_at`: es un log de solo-inserción, inmutable por
//    diseño. Agregar `updated_at` implicaría que las filas pueden modificarse, lo cual rompería
//    su propósito de auditoría. Excepción justificada, análoga a las que el propio estándar
//    permite para ON DELETE/UPDATE CASCADE en "casos justificados".
// 4. Nombrado de constraints (pk_/fk_ del estándar, sección 4): SQLite no expone constraints de
//    PK/FK con nombre propio en su catálogo (a diferencia de Postgres/SQL Server), así que esa
//    convención no aplica literalmente aquí. Sí se nombran los índices (`idx_`/`uq_`) vía `map:`,
//    que Turso/SQLite sí soporta y que se preserva si el proyecto migra a Postgres (ver DEC-02).
//
// Otras notas técnicas:
// - SQLite/Turso no soporta `enum` nativo de Prisma. Los campos que en otro motor serían enum
//   aquí son String; los valores permitidos están documentados junto a cada campo y deben
//   validarse en los DTOs (class-validator) en NestJS, no solo confiar en el schema.
// - IDs: Int autoincrement. Eficiente para joins/índices — relevante porque Turso cuenta filas
//   escaneadas contra la cuota del free tier (ver DEC-02).
// - Búsqueda de texto (Fase 4): SQLite FTS5 no se modela como `model` de Prisma. Se crea con una
//   migración SQL manual (`prisma migrate dev --create-only` + SQL a mano).
// - Toda tabla obligatoriamente tiene id + created_at + updated_at (deleted_at opcional), por
//   requisito del estándar §2. Las tablas pivote tienen su propio `id` (no PK compuesta), también
//   por requisito del estándar §2/§3.2.

generator client {
  provider = "prisma-client-js"
}

// `provider` se sincroniza con DB_PROVIDER vía `npm run db:prepare` (ver prisma.config.ts).
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Usuarios y roles
// ─────────────────────────────────────────────────────────────

// 4 roles fijos del negocio: SUPERADMIN, ADMINISTRADOR, CLIENTE, USUARIO.
// Se modela como tabla (no enum) para permitir futura extensión sin migrar datos existentes.
// Regla de negocio "el Superadmin no se puede eliminar" se enforced en la capa de servicio
// (guard en el caso de uso de delete), no a nivel de BD.
model Role {
  id Int @id @default(autoincrement())

  name String @map("role") // campo descriptivo principal, nombrado como la tabla (singular) — regla del estándar
  slug String @unique @map("code_role") // "SUPERADMIN" | "ADMINISTRADOR" | "CLIENTE" | "USUARIO"

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users User[]

  @@map("roles")
}

// Seguridad de autenticación (DEC-05): soporta login tradicional (email+clave) y OAuth2 con
// UN proveedor activo a la vez (inicialmente Google, extensible a otros sin migrar el schema).
// Regla de privacidad: ante credenciales inválidas, cuenta inexistente, o cuenta solo-OAuth
// (passwordHash NULL), el backend SIEMPRE responde el mismo mensaje genérico de error — nunca
// debe ser posible inferir desde la respuesta si un email existe o qué método de auth usa
// (previene User Enumeration). Ver TASKS.md Fase 1 para los criterios de aceptación exactos.
model User {
  id Int @id @default(autoincrement())

  email        String  @unique @map("email")
  passwordHash String? @map("password_hash") // NULL si el usuario solo usa OAuth2

  // auth_method: "local" | "google" | "both" — decide qué plantilla de correo dispara el flujo
  // de "olvidé mi contraseña" (ver TASKS.md). Se mantiene sincronizado por la capa de servicio
  // cada vez que el usuario setea clave o vincula/desvincula OAuth — no es un campo derivado en BD.
  authMethod String @default("local") @map("auth_method")

  // Datos del proveedor OAuth2 activo. Ambos NULL si el usuario es 100% local.
  // provider: "google" (valor único soportado inicialmente; extensible a futuro sin migrar schema)
  provider   String? @map("provider")
  providerId String? @map("provider_code") // ID único que entrega el proveedor (ej. Google "sub")

  firstName String  @map("first_name")
  lastName  String  @map("last_name")
  // full_name: concatenación automática (firstName + " " + lastName), calculada por la capa de
  // aplicación en cada create/update — no es una columna generada por SQLite (evita depender de
  // GENERATED ALWAYS AS, que requeriría migración SQL manual fuera de Prisma).
  fullName  String  @map("full_name")
  avatarUrl String? @map("avatar_url") // URL de foto de perfil (autocompletada desde Google en login OAuth)

  phone    String? @map("phone") // teléfono general/alterno
  whatsapp String? @map("whatsapp") // canal de contacto principal — capturado obligatorio en checkout (Fase 7)
  telegram String? @map("telegram") // handle para verificación manual de acceso a comunidad privada (Fase 5)

  // Token de notificaciones push. NOTA: un solo campo = un solo dispositivo activo por usuario.
  // Fuera del alcance del documento de requerimientos original — confirmar si se necesita ya
  // o es para una fase futura; si se requiere multi-dispositivo, migrar a tabla `UserPushToken`.
  pnsToken String? @map("push_notification_token")

  country String? @map("country")
  city    String? @map("city")
  address String? @map("address")

  roleId Int
  role   Role @relation(fields: [roleId], references: [id])

  // is_blocked: revocación temporal de acceso (disputas, cancelaciones) — la cuenta sigue existiendo.
  // deletedAt: baja definitiva (soft delete) — distinto de isBlocked, ver nota de soft delete abajo.
  isBlocked   Boolean   @default(false) @map("is_blocked")
  lastLoginAt DateTime? @map("last_login_at")

  // Verificación de email — se autocompleta al registrarse vía OAuth (Google ya lo verificó).
  emailVerifiedAt DateTime? @map("email_verified_at")

  // Email OTP (Fase 1)
  otpCode       String?   @map("otp_code")
  otpExpiresAt  DateTime? @map("otp_expires_at")
  otpVerifiedAt DateTime? @map("otp_verified_at")

  // Recuperación de contraseña: se guarda el HASH del token (nunca el token en texto plano —
  // mismo criterio que la contraseña, por si la BD se filtra) y su expiración explícita.
  // Ver flujo completo de bifurcación local/OAuth en TASKS.md Fase 1.
  resetPasswordTokenHash      String?   @map("reset_password_token_hash")
  resetPasswordTokenExpiresAt DateTime? @map("reset_password_token_expires_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at") // soft delete — baja definitiva, distinto de is_blocked

  subscriptions     Subscription[]
  uploadedResources Resource[]     @relation("ResourceUploadedBy")
  tickets           Ticket[]       @relation("TicketCreatedBy")
  auditLogs         AuditLog[]
  favorites         Favorite[]

  @@unique([provider, providerId], map: "uq_users_provider_provider_code")
  @@index([roleId], map: "idx_users_role_id") // índice: guards filtran por rol constantemente
  @@map("users")
}

// ─────────────────────────────────────────────────────────────
// Planes y suscripciones
// ─────────────────────────────────────────────────────────────

model Plan {
  id Int @id @default(autoincrement())

  name        String  @map("plan") // campo descriptivo principal, nombrado como la tabla (singular)
  description String? @map("description")

  // billing_interval: "MENSUAL" | "ANUAL"
  billingInterval String @default("MENSUAL") @map("billing_interval")

  // Monto en la unidad mínima de la moneda (centavos) — se evita punto flotante para dinero.
  // Ver nota de "Moneda" al inicio del archivo (SQLite no tiene tipo DECIMAL).
  priceCents Int    @map("price_cents")
  currency   String @default("USD") @map("currency")

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at") // soft delete — un plan referenciado por suscripciones históricas no debe borrarse físicamente

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id Int @id @default(autoincrement())

  userId Int  @map("user_id")
  user   User @relation(fields: [userId], references: [id])

  planId Int  @map("plan_id")
  plan   Plan @relation(fields: [planId], references: [id])

  // status: "ACTIVA" | "CANCELADA" | "VENCIDA"
  status String @default("ACTIVA") @map("status")

  startedAt   DateTime  @default(now()) @map("started_at")
  renewsAt    DateTime? @map("renews_at")
  cancelledAt DateTime? @map("cancelled_at")

  // Referencia al pago/suscripción en la pasarela externa (Fase 8, pasarela por definir)
  paymentGatewayRef String? @map("payment_gateway_ref")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId], map: "idx_subscriptions_user_id")
  @@index([status], map: "idx_subscriptions_status") // índice: guard de suscripción activa consulta esto en cada descarga
  @@map("subscriptions")
}

// ─────────────────────────────────────────────────────────────
// Recursos (imagen + comprimido opcional + thumbnails) y categorías
// ─────────────────────────────────────────────────────────────

model Category {
  id Int @id @default(autoincrement())

  name String @unique @map("category") // campo descriptivo principal, nombrado como la tabla (singular)
  slug String @unique @map("category_code")

  resources ResourceCategory[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at") // soft delete — evita romper el historial de recursos ya categorizados

  @@map("categories")
}

// Un recurso siempre tiene una imagen de preview (lo que se muestra en catálogo/landing).
// Opcionalmente tiene un comprimido con los archivos reales de impresión (distintos formatos
// de esa misma imagen). Peor caso: solo existe la imagen, sin comprimido — visibility=FREE
// suele darse en ese caso.
model Resource {
  id Int @id @default(autoincrement())

  // "title" (no "resource") — forzar el nombre de tabla aquí sería confuso; ver nota de
  // desviaciones al inicio del archivo.
  title       String  @map("title")
  description String? @map("description")

  // Imagen de preview — obligatoria. Es lo único garantizado que existe siempre.
  previewImageKey       String @map("preview_image_key")
  previewImageSizeBytes Int    @map("preview_image_size_bytes")
  previewImageMimeType  String @map("preview_image_mime_type") // "image/png" | "image/jpeg" | "image/webp" ...

  // Comprimido con los archivos de impresión — opcional (puede no existir).
  // compressed_file_type: "ZIP" | "RAR" | "TAR"
  // El peso máximo (variable global, Fase 1) se valida principalmente contra
  // compressedFileSizeBytes, que es el archivo pesado; previewImageSizeBytes normalmente ya es liviano.
  compressedFileKey       String? @map("compressed_file_key")
  compressedFileSizeBytes Int?    @map("compressed_file_size_bytes")
  compressedFileType      String? @map("compressed_file_type")

  // Thumbnails: generados de forma asíncrona tras la carga (background job), a partir de previewImageKey.
  // NO se modelan como tabla — se derivan por convención de nombre de archivo en código, no en BD:
  //   "<previewImageKey sin extensión>-thumb_<alto>x<ancho>.jpg"
  // Tamaños fijos definidos por convención de negocio/código (constante compartida, ej.
  // src/resources/constants/thumbnail-sizes.ts — no en este schema):
  //   SMALL  = 300 (alto) x 300 (ancho) px — grillas/catálogo de recursos
  //   MEDIUM = 600 (alto) x 600 (ancho) px — vista de detalle/preview ampliado
  // thumbnailsGeneratedAt: null mientras el job no ha corrido o falló — evita servir la imagen
  // pesada en el catálogo antes de que existan los .jpg derivados en storage.
  thumbnailsGeneratedAt DateTime? @map("thumbnails_generated_at")

  // visibility: "FREE" | "PREMIUM" — controla qué se muestra en la landing pública (Fase 5)
  visibility String @default("PREMIUM") @map("visibility")

  uploadedById Int  @map("uploaded_by_id")
  uploadedBy   User @relation("ResourceUploadedBy", fields: [uploadedById], references: [id])

  categories    ResourceCategory[]
  productTypes  ResourceProductType[]
  tickets       Ticket[]              @relation("TicketAboutResource")
  favoritedBy   Favorite[]
  stats         ResourceStats?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at") // soft delete — el requerimiento pide conservar fecha de eliminación

  @@index([visibility], map: "idx_resources_visibility") // índice: landing pública y catálogo filtran por free/premium
  @@index([uploadedById], map: "idx_resources_uploaded_by_id")
  @@map("resources")
}

// ─────────────────────────────────────────────────────────────
// Favoritos
// ─────────────────────────────────────────────────────────────

// Un usuario marca un recurso como favorito — alimenta el listado "Mis favoritos" del dashboard.
// Entidad propia (no solo contador) porque hay que saber CUÁLES recursos favoritó CADA usuario,
// no solo cuántos en total (ese conteo vive, ya denormalizado, en ResourceStats.favoritesCount).
model Favorite {
  id Int @id @default(autoincrement())

  userId Int  @map("user_id")
  user   User @relation(fields: [userId], references: [id])

  resourceId Int      @map("resource_id")
  resource   Resource @relation(fields: [resourceId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, resourceId], map: "uq_favorites_user_id_resource_id")
  @@index([userId], map: "idx_favorites_user_id") // dashboard: listado de favoritos por usuario
  @@index([resourceId], map: "idx_favorites_resource_id")
  @@map("favorites")
}

// Contadores denormalizados 1:1 con Resource — evita hacer COUNT(*) sobre favorites y JOIN con
// audit_logs en cada request de catálogo/detalle (requisito explícito: evitar queries complejos
// y demorados). La capa de servicio mantiene estos contadores sincronizados en la misma
// transacción que crea/borra el Favorite, registra un "me gusta" o una descarga — no son
// columnas generadas por SQL.
// likesCount: contador simple de "me gusta", incrementado/decrementado directamente por la capa
// de servicio. No existe una tabla `resource_likes` por usuario (se descartó a propósito: no hay
// nada desarrollado aún sobre esa función y generaría el mismo tipo de queries/mantenimiento que
// `favorites` sin necesidad confirmada de saber CUÁL usuario dio like a CUÁL recurso). Si más
// adelante se necesita ese detalle (ej. deduplicar likes por usuario, o listar "recursos que
// me gustaron"), reintroducir una tabla `ResourceLike` con el mismo patrón que `Favorite`.
model ResourceStats {
  id Int @id @default(autoincrement())

  downloadsCount Int @default(0) @map("downloads_count")
  likesCount     Int @default(0) @map("likes_count")
  favoritesCount Int @default(0) @map("favorites_count")

  lastDownloadedAt DateTime? @map("last_downloaded_at")
  // lastLikedAt: fecha del "me gusta" más reciente. Se actualiza junto con likesCount, sin
  // depender de una tabla resource_likes — útil para ordenar por actividad/tendencia reciente.
  lastLikedAt DateTime? @map("last_liked_at")

  // FK al final, antes de auditoría — Estandar_desarrrollo_bases_datos.md §3.1.
  resourceId Int      @unique @map("resource_id")
  resource   Resource @relation(fields: [resourceId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("resource_stats")
}

// ─────────────────────────────────────────────────────────────
// Tipos de producto (ej. t-shirt, mug, cojín) — catálogo independiente de Category
// ─────────────────────────────────────────────────────────────

// Mismo patrón que Category: un recurso puede ilustrar varios tipos de producto físico
// (ej. un mismo diseño navideño usado en taza Y camiseta), y esta clasificación es ortogonal
// a la temática/categoría del recurso (navidad, verano, día de la madre...).
model ProductType {
  id Int @id @default(autoincrement())

  name String @unique @map("product_type") // campo descriptivo principal, nombrado como la tabla (singular)
  slug String @unique @map("product_type_code")

  resources ResourceProductType[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at") // soft delete — evita romper el historial de recursos ya clasificados

  @@map("product_types")
}

// Tabla pivote N:M explícita, mismo patrón que ResourceCategory. Nombre en BD ordenado
// alfabéticamente por tabla ("product_types" antes que "resources"), según el estándar.
model ResourceProductType {
  id Int @id @default(autoincrement())

  resourceId Int      @map("resource_id")
  resource   Resource @relation(fields: [resourceId], references: [id])

  productTypeId Int         @map("product_type_id")
  productType   ProductType @relation(fields: [productTypeId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([resourceId, productTypeId], map: "uq_product_types_resources_resource_id_product_type_id")
  @@index([productTypeId], map: "idx_product_types_resources_product_type_id") // índice: catálogo filtra por tipo de producto
  @@index([resourceId], map: "idx_product_types_resources_resource_id")
  @@map("product_types_resources")
}

// Tabla pivote N:M explícita. Nombre en BD ordenado alfabéticamente por tabla ("categories" antes
// que "resources"), según el estándar. Tiene su propio `id` (no PK compuesta) — requisito explícito
// del estándar §2/§3.2 para tablas pivote, más los índices en ambas FK y el unique que reemplaza
// la antigua PK compuesta para seguir evitando duplicados.
model ResourceCategory {
  id Int @id @default(autoincrement())

  resourceId Int      @map("resource_id")
  resource   Resource @relation(fields: [resourceId], references: [id])

  categoryId Int      @map("category_id")
  category   Category @relation(fields: [categoryId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([resourceId, categoryId], map: "uq_categories_resources_resource_id_category_id")
  @@index([categoryId], map: "idx_categories_resources_category_id") // índice: catálogo filtra por categoría
  @@index([resourceId], map: "idx_categories_resources_resource_id")
  @@map("categories_resources")
}

// ─────────────────────────────────────────────────────────────
// Tickets / mensajes
// ─────────────────────────────────────────────────────────────

model Ticket {
  id Int @id @default(autoincrement())

  // type: "GENERAL" | "RECURSO"
  type String @map("type")

  subject String @map("subject")
  message String @map("message")

  // priority: "BAJA" | "MEDIA" | "ALTA" | "URGENTE"
  priority String @default("MEDIA") @map("priority")

  // status: "ABIERTO" | "EN_PROCESO" | "CERRADO"
  status String @default("ABIERTO") @map("status")

  createdById Int  @map("created_by_id")
  createdBy   User @relation("TicketCreatedBy", fields: [createdById], references: [id])

  // Solo aplica si type = "RECURSO"
  resourceId Int?      @map("resource_id")
  resource   Resource? @relation("TicketAboutResource", fields: [resourceId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([priority, status], map: "idx_tickets_priority_status") // índice: vista admin ordena por prioridad
  @@index([createdById], map: "idx_tickets_created_by_id")
  @@map("tickets")
}

// ─────────────────────────────────────────────────────────────
// Auditoría (transversal — ver DEC-01: misma transacción que la acción auditada)
// ─────────────────────────────────────────────────────────────

// Sin `updated_at`: log de solo-inserción, inmutable por diseño (ver nota de desviaciones
// al inicio del archivo). Nunca se actualiza ni se borra una fila de auditoría.
model AuditLog {
  id Int @id @default(autoincrement())

  // Módulo que originó la acción (ej. "users", "resources", "payments") — requisito explícito del negocio
  module String @map("module")

  // action: "CREATE" | "UPDATE" | "DELETE" | "PAY" | "UPLOAD" (u otro string libre si se necesita)
  action String @map("action")

  entityType String @map("entity_type") // ej. "User", "Resource", "Subscription"
  entityId   Int?   @map("entity_id")

  userId Int?  @map("user_id")
  user   User? @relation(fields: [userId], references: [id])

  // Payload variable de la acción (antes/después, metadata) — estructura libre
  payload Json? @map("payload")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([module], map: "idx_audit_logs_module")
  @@index([entityType, entityId], map: "idx_audit_logs_entity_type_entity_id")
  @@index([createdAt], map: "idx_audit_logs_created_at") // índice: soporta el job de rotación/archivado (Fase 9)
  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────────
// Variables globales
// ─────────────────────────────────────────────────────────────

model GlobalVariable {
  id  Int    @id @default(autoincrement())
  key String @unique @map("key")

  // Módulo dueño de la variable, o null si es verdaderamente global
  scope String? @map("scope")

  // value_type: "SCALAR" | "JSON" — determina cómo la interfaz de lectura/escritura interpreta `value`
  valueType String @map("value_type")

  // Almacena tanto escalares (envueltos, ej. {"value": 50}) como estructuras complejas.
  // Consultado con json_extract() cuando se necesita filtrar/indexar por una clave interna (ver DEC-02).
  value Json @map("value")

  description String? @map("description")

  updatedAt DateTime  @updatedAt @map("updated_at")
  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([scope], map: "idx_global_variables_scope")
  @@map("global_variables")
}
