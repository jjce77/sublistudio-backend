# App
NODE_ENV=development
PORT=3000

# URL pública donde corre este backend. Único lugar que define el dominio: los callbacks de
# OAuth2 (y cualquier otro enlace absoluto que el backend genere) se construyen a partir de
# esta variable, en vez de repetir el dominio en un *_CALLBACK_URL por proveedor — así solo
# hay que actualizar una variable al pasar de localhost a un dominio real.
API_BASE_URL=http://localhost:3000

# CORS — origen(es) permitido(s) del frontend Angular
CORS_ORIGIN=http://localhost:4200

# Motor de BD para Prisma (multi-motor autorizado — ver CLAUDE.md).
# Valores válidos: turso-sqlite | postgresql | mysql | sqlite
# - turso-sqlite: usa el adapter PrismaLibSQL (TURSO_DATABASE_URL/TURSO_AUTH_TOKEN abajo).
# - postgresql/mysql/sqlite: motor nativo de Prisma, sin adapter — DATABASE_URL debe ser la
#   connection string/ruta real de ese motor (reemplaza el placeholder de abajo). Para "sqlite"
#   (local, sin Turso) el placeholder de abajo ya sirve tal cual (es un `file:` real).
DB_PROVIDER=turso-sqlite

# Turso / libSQL — solo aplica si DB_PROVIDER=turso-sqlite
# Desarrollo local: usa `turso dev` y deja TURSO_DATABASE_URL=http://127.0.0.1:8080
# Turso Cloud: URL y token generados desde el dashboard web de Turso (Database > Connect)
TURSO_DATABASE_URL=libsql://tu-db.turso.io
TURSO_AUTH_TOKEN=

# DATABASE_URL: su significado depende de DB_PROVIDER.
# - turso-sqlite: placeholder — Prisma exige formato nativo `file:` para validar el schema,
#   pero la conexión real va por el adapter PrismaLibSQL (TURSO_DATABASE_URL/TURSO_AUTH_TOKEN
#   arriba), nunca por este valor.
# - postgresql/mysql: connection string REAL de ese motor (ej. postgresql://user:pass@host:5432/db).
# - sqlite: ruta REAL a un archivo local (este mismo valor ya sirve, sin Turso de por medio).
DATABASE_URL=file:./prisma/dev.db

# Redis (cache / colas)
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_ACCESS_SECRET=changeme-access-secret
JWT_REFRESH_SECRET=changeme-refresh-secret
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Storage — driver "local" (carpeta local) o proveedor cloud
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage

# Correo saliente — driver "console" (default): loguea el correo en vez de enviarlo de verdad.
# Cambiar a un proveedor real (Resend, SES, SMTP...) es una decisión de negocio pendiente.
MAILER_DRIVER=console
MAILER_FROM=no-reply@sublistudio.local

# OAuth2. El callback de cada proveedor se arma solo como {API_BASE_URL}/auth/<provider>/callback
# — no existe (ni hace falta) una variable de callback separada por proveedor, ver API_BASE_URL arriba.
# Tener estas credenciales configuradas NO habilita el proveedor por sí solo: un admin debe
# activarlo explícitamente desde el panel (persistido en Variables Globales).

# OAuth2 — Credenciales desde Google Cloud
# Console (APIs & Services > Credentials > OAuth client ID, tipo "Web application").
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# OAuth2 — Credenciales desde Facebook
# Developers (developers.facebook.com > tu app > Configuración básica: App ID / App Secret).
FACEBOOK_OAUTH_CLIENT_ID=
FACEBOOK_OAUTH_CLIENT_SECRET=

# OAuth2 — Credenciales desde LinkedIn Developer Portal
# (developer.linkedin.com > tu app > Auth: Client ID / Client Secret).
LINKEDIN_OAUTH_CLIENT_ID=
LINKEDIN_OAUTH_CLIENT_SECRET=
