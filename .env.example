# App
NODE_ENV=development
PORT=3000

# CORS — origen(es) permitido(s) del frontend Angular (DEC-03)
CORS_ORIGIN=http://localhost:4200

# Turso / libSQL (DEC-02)
# Desarrollo local: usa `turso dev` y deja TURSO_DATABASE_URL=http://127.0.0.1:8080
# Turso Cloud: URL y token generados desde el dashboard web de Turso (Database > Connect)
TURSO_DATABASE_URL=libsql://tu-db.turso.io
TURSO_AUTH_TOKEN=

# Prisma + libSQL (patrón Prisma 6.6+): el adapter PrismaLibSQL se instancia en código
# (src/prisma/prisma.service.ts) con { url, authToken } como parámetros separados —
# NO es una connection string estilo Postgres con usuario:contraseña embebidos.
# DATABASE_URL solo necesita el mismo valor que TURSO_DATABASE_URL (la CLI de Prisma
# lo usa para `migrate`/`studio`); el authToken se pasa aparte en el adapter, nunca aquí.
DATABASE_URL=libsql://tu-db.turso.io

# Redis (cache / colas)
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT (Fase 1)
JWT_ACCESS_SECRET=changeme-access-secret
JWT_REFRESH_SECRET=changeme-refresh-secret
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Storage — Fase 0: carpeta local. Fase 9: reemplazar por proveedor cloud (ver adr-sublistudio.md DEC-04)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
