# App
NODE_ENV=development
PORT=3000

# CORS — origen(es) permitido(s) del frontend Angular (DEC-03)
CORS_ORIGIN=http://localhost:4200

# Turso / libSQL (DEC-02)
# Desarrollo local: usa `turso dev` y deja TURSO_DATABASE_URL=http://127.0.0.1:8080
# Turso Cloud: turso db show <db-name> --url  /  turso db tokens create <db-name>
TURSO_DATABASE_URL=http://127.0.0.1:8080
TURSO_AUTH_TOKEN=

# Prisma (usa el driver adapter de libSQL — ver prisma/schema.prisma)
DATABASE_URL="file:./dev.db"

# Redis (cache / colas)
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT (Fase 1)
JWT_ACCESS_SECRET=changeme-access-secret
JWT_REFRESH_SECRET=changeme-refresh-secret
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Storage — Fase 0: carpeta local. Fase 9: reemplazar por proveedor cloud (ver adr-sublistudio.md DEC-04)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
